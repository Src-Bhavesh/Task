<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Streamflix | Browse</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #141414;
            color: #fff;
            overflow-x: hidden;
        }

        /* NAVBAR */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            height: 68px;
            padding: 0 3rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
            z-index: 100;
        }

        .left-nav {
            display: flex;
            align-items: center;
            gap: 2.5rem;
        }

        .logo {
            color: #E50914;
            font-size: 1.8rem;
            font-weight: 900;
            letter-spacing: -1px;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 1.25rem;
        }

        .nav-links a {
            color: #e5e5e5;
            text-decoration: none;
            font-size: 0.85rem;
            transition: color 0.2s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: #fff;
            font-weight: 700;
        }

        .right-nav {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .profile-badge {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
            color: #e5e5e5;
        }

        .profile-icon {
            width: 32px;
            height: 32px;
            border-radius: 4px;
            background: #E50914;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .logout-link {
            background: #222;
            color: #aaa;
            padding: 0.35rem 0.75rem;
            border-radius: 4px;
            font-size: 0.8rem;
            text-decoration: none;
            border: 1px solid #333;
        }

        .logout-link:hover {
            color: #fff;
            border-color: #555;
        }

        /* HERO BANNER */
        .hero {
            position: relative;
            height: 60vh;
            min-height: 400px;
            background: linear-gradient(to top, #141414 5%, transparent 70%),
                        linear-gradient(to right, rgba(0,0,0,0.8) 0%, transparent 60%),
                        url('https://assets.nflxext.com/ffe/siteui/vlv3/f841d4c7-10e1-40af-b4e0-e82f0bb1683a/web/US-en-20220502-popsignuptwoweeks-perspective_alpha_website_medium.jpg') center/cover;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 0 3rem 4rem;
        }

        .hero h1 {
            font-size: 3rem;
            margin-bottom: 0.8rem;
        }

        .hero p {
            max-width: 500px;
            font-size: 1rem;
            line-height: 1.4;
            color: #ccc;
            margin-bottom: 1.5rem;
        }

        .btn-group {
            display: flex;
            gap: 0.75rem;
        }

        .btn {
            padding: 0.6rem 1.5rem;
            border-radius: 4px;
            font-size: 1rem;
            font-weight: 700;
            border: none;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-white {
            background: #fff;
            color: #000;
        }

        .btn-gray {
            background: rgba(109, 109, 110, 0.7);
            color: #fff;
        }

        /* ROW CARDS */
        .row-section {
            padding: 0 3rem 3rem;
        }

        .row-section h2 {
            font-size: 1.25rem;
            margin-bottom: 0.75rem;
        }

        .row-posters {
            display: flex;
            gap: 0.65rem;
            overflow-x: auto;
            padding: 0.5rem 0;
            scrollbar-width: none;
        }

        .row-posters::-webkit-scrollbar {
            display: none;
        }

        .card-dummy {
            flex: 0 0 200px;
            height: 120px;
            background: #262626;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            color: #777;
            font-weight: 600;
            transition: transform 0.2s ease, border-color 0.2s ease;
            cursor: pointer;
            border: 1px solid transparent;
        }

        .card-dummy:hover {
            transform: scale(1.05);
            border-color: #555;
            color: #ccc;
        }
    </style>
</head>
<body>

    <!-- TOP NAVIGATION -->
    <nav>
        <div class="left-nav">
            <div class="logo">STREAMFLIX</div>
            <ul class="nav-links">
                <li><a href="#" class="active">Home</a></li>
                <li><a href="#">TV Shows</a></li>
                <li><a href="#">Movies</a></li>
                <li><a href="#">New & Popular</a></li>
            </ul>
        </div>
        <div class="right-nav">
            <div class="profile-badge">
                <div class="profile-icon">
                    <%= user && user.username ? user.username.charAt(0).toUpperCase() : "U" %>
                </div>
                <span><%= user && user.username ? user.username : (user && user.UserID ? user.UserID.toString().slice(-4) : "Member") %></span>
            </div>
            <a href="/logout" class="logout-link">Exit</a>
        </div>
    </nav>

    <!-- FEATURED HERO -->
    <header class="hero">
        <h1>Current Stream</h1>
        <p>Your subscription is active via encrypted JWT cookie. Session authorization verified for User ID: <strong><%= user && user.UserID ? user.UserID : "Authenticated" %></strong>.</p>
        <div class="btn-group">
            <a href="#" class="btn btn-white">▶ Play</a>
            <a href="#" class="btn btn-gray">ⓘ More Info</a>
        </div>
    </header>

    <!-- CONTENT ROWS -->
    <section class="row-section">
        <h2>Trending Movies</h2>
        <div class="row-posters">
            <% if (typeof movies !== 'undefined' && movies.length > 0) { %>
                <% movies.slice(0, 10).forEach(movie => { %>
                    <div class="card-dummy" title="<%= movie.title %> - ⭐ <%= movie.vote_average %>" style="background-image: url('https://image.tmdb.org/t/p/w500<%= movie.poster_path %>'); background-size: cover; background-position: center; position: relative;">
                        <span style="position: absolute; bottom: 5px; left: 5px; background: rgba(0,0,0,0.8); color: #fff; padding: 3px 6px; border-radius: 3px; font-size: 0.75rem; font-weight: bold; text-align: left; max-width: 90%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
                            <%= movie.title %>
                        </span>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="card-dummy">No Movies Found</div>
            <% } %>
        </div>
    </section>

    <section class="row-section">
        <h2>Recommended For You</h2>
        <div class="row-posters">
            <% if (typeof movies !== 'undefined' && movies.length > 10) { %>
                <% movies.slice(10, 20).forEach(movie => { %>
                    <div class="card-dummy" title="<%= movie.title %> - ⭐ <%= movie.vote_average %>" style="background-image: url('https://image.tmdb.org/t/p/w500<%= movie.poster_path %>'); background-size: cover; background-position: center; position: relative;">
                        <span style="position: absolute; bottom: 5px; left: 5px; background: rgba(0,0,0,0.8); color: #fff; padding: 3px 6px; border-radius: 3px; font-size: 0.75rem; font-weight: bold; text-align: left; max-width: 90%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
                            <%= movie.title %>
                        </span>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="card-dummy">More Movies Coming Soon</div>
            <% } %>
        </div>
    </section>

</body>
</html>