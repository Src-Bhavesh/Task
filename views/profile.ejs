<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Streamflix | My List</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #141414;
            color: #fff;
            overflow-x: hidden;
        }

        /* NAVBAR */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            height: 68px;
            padding: 0 3rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(0,0,0,0.9);
            z-index: 100;
        }

        .left-nav {
            display: flex;
            align-items: center;
            gap: 2.5rem;
        }

        .logo {
            color: #E50914;
            font-size: 1.8rem;
            font-weight: 900;
            letter-spacing: -1px;
            text-decoration: none;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 1.25rem;
        }

        .nav-links a {
            color: #e5e5e5;
            text-decoration: none;
            font-size: 0.85rem;
            transition: color 0.2s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: #fff;
            font-weight: 700;
        }

        .right-nav {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .profile-badge {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
            color: #e5e5e5;
        }

        .profile-icon {
            width: 32px;
            height: 32px;
            border-radius: 4px;
            background: #E50914;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .logout-link {
            background: #222;
            color: #aaa;
            padding: 0.35rem 0.75rem;
            border-radius: 4px;
            font-size: 0.8rem;
            text-decoration: none;
            border: 1px solid #333;
        }

        .logout-link:hover {
            color: #fff;
            border-color: #555;
        }

        /* PROFILE SECTION */
        .profile-container {
            padding: 100px 3rem 3rem;
        }
        
        .profile-header {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid #333;
            padding-bottom: 2rem;
        }
        
        .profile-header .big-icon {
            width: 80px;
            height: 80px;
            border-radius: 8px;
            background: #E50914;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: bold;
        }

        .profile-container h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }
        
        .profile-container p {
            color: #aaa;
            font-size: 1.1rem;
        }

        .profile-container h2 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .grid-posters {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
        }

        .card-dummy {
            height: 300px;
            background: #262626;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            color: #777;
            font-weight: 600;
            transition: transform 0.2s ease, border-color 0.2s ease;
            cursor: pointer;
            border: 1px solid transparent;
            position: relative;
        }

        .card-dummy:hover {
            transform: scale(1.05);
            border-color: #555;
            z-index: 10;
        }
    </style>
</head>
<body>

    <!-- TOP NAVIGATION -->
    <nav>
        <div class="left-nav">
            <a href="/dashboard" class="logo">STREAMFLIX</a>
            <ul class="nav-links">
                <li><a href="/dashboard">Home</a></li>
                <li><a href="/profile" class="active">My List</a></li>
                <li><a href="#">TV Shows</a></li>
                <li><a href="#">Movies</a></li>
            </ul>
        </div>
        <div class="right-nav">
            <div class="profile-badge">
                <div class="profile-icon">
                    <%= user && user.username ? user.username.charAt(0).toUpperCase() : "U" %>
                </div>
                <span><%= user && user.username ? user.username : (user && user.UserID ? user.UserID.toString().slice(-4) : "Member") %></span>
            </div>
            <a href="/logout" class="logout-link">Exit</a>
        </div>
    </nav>

    <div class="profile-container">
        <div class="profile-header">
            <div class="big-icon">
                <%= user && user.username ? user.username.charAt(0).toUpperCase() : "U" %>
            </div>
            <div>
                <h1><%= user && user.username ? user.username : "Member" %>'s Profile</h1>
                <p><%= user && user.email ? user.email : "Authenticated User" %></p>
            </div>
        </div>

        <h2>My List (<%= savedMovies ? savedMovies.length : 0 %>)</h2>
        
        <div class="grid-posters">
            <% if (typeof savedMovies !== 'undefined' && savedMovies.length > 0) { %>
                <% savedMovies.forEach(movie => { %>
                    <div class="card-dummy" title="<%= movie.title %> - ⭐ <%= movie.vote_average || 'N/A' %>" style="background-image: url('https://image.tmdb.org/t/p/w500<%= movie.poster_path %>'); background-size: cover; background-position: center;">
                        <span style="position: absolute; bottom: 5px; left: 5px; background: rgba(0,0,0,0.8); color: #fff; padding: 3px 6px; border-radius: 3px; font-size: 0.75rem; font-weight: bold; text-align: left; max-width: 90%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
                            <%= movie.title %>
                        </span>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: #777; grid-column: 1 / -1;">You haven't saved any movies yet! Head over to the dashboard to start building your list.</p>
            <% } %>
        </div>
    </div>

</body>
</html>
