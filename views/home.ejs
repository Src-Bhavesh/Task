<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Netflix Clone | Watch TV Shows Online, Watch Movies Online</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        }

        body {
            background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 60%, rgba(0, 0, 0, 0.9) 100%),
                        url('https://assets.nflxext.com/ffe/siteui/vlv3/f841d4c7-10e1-40af-b4e0-e82f0bb1683a/web/US-en-20220502-popsignuptwoweeks-perspective_alpha_website_medium.jpg') center/cover no-repeat fixed;
            min-height: 100vh;
            color: #fff;
            display: flex;
            flex-direction: column;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 3rem;
        }

        .logo {
            color: #E50914;
            font-size: 2.2rem;
            font-weight: 900;
            letter-spacing: -1px;
            text-transform: uppercase;
        }

        .sign-in-btn {
            background-color: #E50914;
            color: #fff;
            padding: 0.45rem 1.1rem;
            font-size: 0.95rem;
            font-weight: 500;
            border-radius: 4px;
            text-decoration: none;
            transition: background 0.2s ease;
        }

        .sign-in-btn:hover {
            background-color: #c11119;
        }

        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 2rem;
        }

        h1 {
            font-size: clamp(2rem, 5vw, 3.2rem);
            font-weight: 800;
            max-width: 700px;
            margin-bottom: 1rem;
            line-height: 1.15;
        }

        p.sub-title {
            font-size: 1.4rem;
            margin-bottom: 1.25rem;
            font-weight: 400;
        }

        p.cta-text {
            font-size: 1.05rem;
            margin-bottom: 1.75rem;
            color: #d1d5db;
        }

        .cta-group {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .btn-register {
            background-color: #E50914;
            color: #fff;
            font-size: 1.2rem;
            font-weight: 700;
            padding: 0.85rem 1.75rem;
            border-radius: 4px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: background 0.2s ease;
        }

        .btn-register:hover {
            background-color: #c11119;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">STREAMFLIX</div>
        <a href="/login" class="sign-in-btn">Sign In</a>
    </header>

    <main>
        <h1>Unlimited movies, TV shows, and more</h1>
        <p class="sub-title">Watch anywhere. Cancel anytime.</p>
        <p class="cta-text">Ready to watch? Create an account to start your membership.</p>
        
        <div class="cta-group">
            <a href="/register" class="btn-register">Get Started &gt;</a>
        </div>
    </main>

</body>
</html>