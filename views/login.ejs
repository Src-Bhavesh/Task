<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Streamflix | Sign In</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        }

        body {
            background: linear-gradient(to top, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.75)),
                        url('https://assets.nflxext.com/ffe/siteui/vlv3/f841d4c7-10e1-40af-b4e0-e82f0bb1683a/web/US-en-20220502-popsignuptwoweeks-perspective_alpha_website_medium.jpg') center/cover no-repeat fixed;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            color: #fff;
        }

        header {
            padding: 1.5rem 3rem;
        }

        .logo {
            color: #E50914;
            font-size: 2.2rem;
            font-weight: 900;
            text-decoration: none;
            letter-spacing: -1px;
            display: inline-block;
        }

        .container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .card {
            background-color: rgba(0, 0, 0, 0.75);
            width: 100%;
            max-width: 420px;
            padding: 3.5rem 3rem;
            border-radius: 4px;
        }

        h1 {
            font-size: 1.9rem;
            font-weight: 700;
            margin-bottom: 1.75rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        input {
            width: 100%;
            padding: 1rem;
            background: #333333;
            border: none;
            border-radius: 4px;
            color: #fff;
            font-size: 0.95rem;
            outline: none;
        }

        input:focus {
            background: #454545;
        }

        .submit-btn {
            width: 100%;
            background: #E50914;
            color: #fff;
            border: none;
            border-radius: 4px;
            padding: 0.95rem;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            margin-top: 1.25rem;
            transition: background 0.2s ease;
        }

        .submit-btn:hover {
            background: #c11119;
        }

        .footer {
            margin-top: 2rem;
            color: #737373;
            font-size: 0.95rem;
        }

        .footer a {
            color: #fff;
            text-decoration: none;
        }

        .footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <header>
        <a href="/" class="logo">STREAMFLIX</a>
    </header>

    <div class="container">
        <div class="card">
            <h1>Sign In</h1>
            <form action="/login" method="POST">
                <div class="form-group">
                    <input type="email" name="email" placeholder="Email address" required autocomplete="email" />
                </div>
                <div class="form-group">
                    <input type="password" name="password" placeholder="Password" required autocomplete="current-password" />
                </div>
                <button type="submit" class="submit-btn">Sign In</button>
            </form>
            <div class="footer">
                New to Streamflix? <a href="/register">Sign up now</a>.
            </div>
        </div>
    </div>

</body>
</html>